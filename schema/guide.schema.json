{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pashtun-origins.example/schema/guide.schema.json",
  "title": "Plain-language guides",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "question", "answer", "where_it_stands", "claims"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "type": "string", "minLength": 10 },
          "answer": { "type": "string", "minLength": 50, "maxLength": 900 },
          "where_it_stands": { "type": "string", "maxLength": 140 },
          "claims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["term", "id", "definition"],
        "properties": {
          "term": { "type": "string" },
          "id": { "$ref": "#/$defs/id" },
          "definition": { "type": "string", "maxLength": 400 }
        }
      }
    }
  }
}
